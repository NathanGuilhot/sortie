{
  "name": "sortie",
  "version": "0.1.0",
  "description": "Picture Tagger & Embedding Electron App",
  "private": true,
  "workspaces": [
    "shared",
    "pipeline",
    "electron"
  ],
  "scripts": {
    "type-check": "tsc --noEmit -p tsconfig.base.json",
    "build": "yarn workspace shared run build && yarn workspace pipeline run build && yarn workspace electron run build",
    "dev": "yarn workspace shared run build && yarn workspace pipeline run build && yarn workspace electron run dev",
    "clean": "yarn workspace shared run clean && yarn workspace pipeline run clean && yarn workspace electron run clean",
    "pipeline": "yarn workspace pipeline start",
    "electron": "yarn workspace electron start",
    "dist": "yarn workspace electron run dist",
    "dist:mac": "yarn workspace electron run dist:mac",
    "dist:win": "yarn workspace electron run dist:win",
    "dist:linux": "yarn workspace electron run dist:linux",
    "package": "yarn workspace electron run package",
    "lint": "eslint shared/src pipeline/src electron/src",
    "lint:fix": "eslint --fix shared/src pipeline/src electron/src",
    "format": "prettier --write \"shared/src/**/*.ts\" \"pipeline/src/**/*.ts\" \"electron/src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"shared/src/**/*.ts\" \"pipeline/src/**/*.ts\" \"electron/src/**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "prettier": "^3.8.3",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.58.2"
  },
  "engines": {
    "node": ">=18"
  }
}
