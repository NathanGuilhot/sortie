{
  "name": "electron",
  "version": "0.1.0",
  "description": "Electron desktop app for Sortie",
  "private": true,
  "main": "./dist/main/index.js",
  "scripts": {
    "build": "tsc && electron-vite build",
    "clean": "rm -rf dist out",
    "type-check": "tsc --noEmit",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "package": "electron-vite build && electron-forge package",
    "make": "electron-vite build && electron-forge make"
  },
  "dependencies": {
    "shared": "*",
    "pipeline": "*",
    "electron-store": "^8.0.0",
    "electron-updater": "^6.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "zustand": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "electron": "^28.0.0",
    "electron-vite": "^2.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@electron-forge/cli": "^7.0.0",
    "vite": "^5.0.0",
    "tailwindcss": "^3.0.0",
    "autoprefixer": "^10.0.0",
    "postcss": "^8.0.0"
  }
}