{
  "appId": "com.sortie.app",
  "productName": "Sortie",
  "directories": {
    "output": "out",
    "buildResources": "resources"
  },
  "files": [
    "dist/**/*",
    "node_modules/**/*",
    "package.json"
  ],
  "asarUnpack": [
    "node_modules/canvas/build/Release/*.node",
    "node_modules/better-sqlite3/build/Release/*.node",
    "**/*.node"
  ],
  "mac": {
    "category": "public.app-category.photography",
    "icon": "resources/icons/icon.icns",
    "target": [
      { "target": "dmg", "arch": ["arm64", "x64"] }
    ],
    "identity": null,
    "hardenedRuntime": false,
    "gatekeeperAssess": false,
    "artifactName": "Sortie-${version}-${arch}.${ext}"
  },
  "win": {
    "target": ["nsis"],
    "icon": "resources/icons/icon.ico",
    "artifactName": "Sortie-Setup-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Sortie"
  },
  "linux": {
    "maintainer": "Nathan Guilhot <nathan.guilhot@gmx.fr>",
    "synopsis": "Local-first photo tagger with CLIP embeddings",
    "category": "Graphics",
    "icon": "resources/icons/icon.png",
    "target": ["AppImage", "deb"]
  },
  "publish": [
    {
      "provider": "github",
      "owner": "nathanguilhot",
      "repo": "sortie"
    }
  ],
  "extends": null
}
